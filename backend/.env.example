# Copia este archivo como .env (en Windows: copy .env.example .env)

# ---- Asistente virtual (Google AI Studio) ----
# Consigue tu clave gratis en https://aistudio.google.com/apikey y pégala aquí:
GEMINI_API_KEY=
# Modelo (opcional). Por defecto, el Flash-Lite más reciente:
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Servidor ----
PORT=4000
FRONTEND_URL=http://localhost:5173
# Solo en producción si el backend está detrás de un proxy:
# TRUST_PROXY=1

# ---- Supabase (opcional) ----
# El backend ya trae los datos del proyecto. Rellénalo solo para usar otro proyecto.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_ANON_KEY=tu-anon-key
